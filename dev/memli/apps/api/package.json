{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply memli --local",
    "db:seed": "wrangler d1 execute memli --local --file=seed/prototype.sql",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "26",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "eslint": "^10",
    "typescript": "~6",
    "vitest": "^5.1.0",
    "wrangler": "^4.103.0"
  },
  "dependencies": {
    "@workspace/core": "workspace:*",
    "@workspace/schemas": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18"
  }
}
