{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": ["e2e/**/*.{ts,tsx}"],
      "project": [
        "src/**/*.{ts,tsx}",
        "e2e/**/*.{ts,tsx}",
        "!src/routeTree.gen.ts"
      ]
    },
    "packages/ui": {
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/schemas": {
      "project": ["src/**/*.ts"]
    },
    "packages/eslint-config": {
      "entry": ["*.{js,mjs,cjs}", "rules/*.test.js"],
      "project": ["*.{js,mjs,cjs}", "rules/*.js"]
    },
    "packages/typescript-config": {
      "entry": [],
      "project": []
    }
  },
  "ignoreIssues": {
    "apps/web/src/components/theme-provider.tsx": ["exports"]
  }
}
