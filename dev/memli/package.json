{
  "name": "memli",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "preview:web": "turbo preview --filter=web",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "knip": "knip",
    "deps:update": "bash scripts/update-deps.sh",
    "cf-typegen": "wrangler types && bun run --cwd apps/api cf-typegen",
    "prepare": "lefthook install",
    "deploy:staging": "turbo build && bunx wrangler deploy --env staging",
    "deploy:prod": "turbo build && bunx wrangler deploy --env=\"\""
  },
  "devDependencies": {
    "@workspace/typescript-config": "workspace:*",
    "knip": "^6.29.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.11.10",
    "typescript": "~6",
    "wrangler": "^4.103.0"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
