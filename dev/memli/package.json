{
  "name": "memli",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "preview:web": "turbo preview --filter=web",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "turbo typecheck",
    "deploy:staging": "turbo build && bunx wrangler deploy --env staging",
    "deploy:prod": "turbo build && bunx wrangler deploy --env=\"\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260626.1",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.15",
    "typescript": "~6",
    "wrangler": "^4.103.0"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
