{
  "name": "memli",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-27",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "env": {
    "staging": {
      "name": "memli-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      },
      "assets": {
        "directory": "./apps/web/dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": true
      }
    }
  }
}
