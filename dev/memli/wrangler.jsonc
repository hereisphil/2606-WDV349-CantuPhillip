{
  "name": "memli",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-27",
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Otherwise the SPA fallback answers /api/* with index.html before the Worker runs.
    "run_worker_first": ["/api/*"]
  },
  "env": {
    "staging": {
      "name": "memli-staging",
      "vars": {
        "ENVIRONMENT": "staging"
      },
      // Set with `wrangler secret put --env staging`. Listed so `wrangler types` types them.
      "secrets": {
        "required": ["BASIC_AUTH_USER", "BASIC_AUTH_PASS"]
      },
      // /api/* goes to apps/api after the gate, so the browser stays on one origin (#165).
      "services": [{ "binding": "API", "service": "memli-api-staging" }],
      "assets": {
        "directory": "./apps/web/dist",
        "not_found_handling": "single-page-application",
        "binding": "ASSETS",
        "run_worker_first": true
      }
    }
  }
}
